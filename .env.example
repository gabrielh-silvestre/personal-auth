NODE_ENV=development # development | test | production; dev/test allow the JWT secret to fall back to "secret"

PORT=3001 # HTTP port
GRPC_URL=localhost:50051 # gRPC server bind address

DB_NAME=database # Mongo database name
MONGO_PORT=27017 # Mongo port
MONGO_URI=mongodb://localhost:${MONGO_PORT}/${DB_NAME} # Mongo connection string

JWT_ACCESS_TOKEN_SECRET=secret # secret used to sign/verify access tokens
JWT_ACCESS_TOKEN_EXPIRES_IN=900000 # access token JWT expiry, ms

JWT_REFRESH_TOKEN_SECRET=secret # secret used to sign/verify refresh tokens
JWT_REFRESH_TOKEN_EXPIRES_IN=604800000 # refresh token JWT expiry, ms

ACCESS_TOKEN_EXPIRE_TIME=86400000 # persisted access token validity, ms (default 86400000)
REFRESH_TOKEN_EXPIRE_TIME=604800000 # persisted refresh token validity, ms (default 604800000)
RECOVER_PASSWORD_TOKEN_EXPIRE_TIME=86400000 # persisted recover-password token validity, ms (default 86400000)

RABBITMQ_PORT=5672 # RabbitMQ AMQP port
RABBITMQ_MANAGEMENT_PORT=15672 # RabbitMQ management UI port
RABBITMQ_USER=guest # RabbitMQ user
RABBITMQ_PASS=guest # RabbitMQ password
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:${RABBITMQ_PORT} # RabbitMQ connection string
RABBITMQ_AUTH_QUEUE=auth # AUTH microservice queue name
RABBITMQ_USER_QUEUE=user # USER microservice queue name
RABBITMQ_MAIL_QUEUE=mail # MAIL microservice queue name

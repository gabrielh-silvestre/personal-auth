PORT=3001

DB_NAME=database

MONGO_PORT=27017
MONGO_URI=mongodb://localhost:${MONGO_PORT}/${DB_NAME}

JWT_ACCESS_TOKEN_SECRET=access-token-secret-change-me
# milliseconds
JWT_ACCESS_TOKEN_EXPIRES_IN=900000

JWT_REFRESH_TOKEN_SECRET=refresh-token-secret-change-me
# milliseconds
JWT_REFRESH_TOKEN_EXPIRES_IN=604800000

# milliseconds
ACCESS_TOKEN_EXPIRE_TIME=86400000
# milliseconds
REFRESH_TOKEN_EXPIRE_TIME=604800000

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:${RABBITMQ_PORT}

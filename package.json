  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --exclude \"**/*.e2e-spec.ts\"",
    "test:unit": "vitest run unit.spec",
    "test:integration": "vitest run integration.spec",
    "test:all": "vitest run",
    "test:e2e": "vitest run e2e-spec",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest",
    "test:mutations": "stryker run --incremental"
  },
  "dependencies": {
